class Solution {
public:
    int majorityElement(vector<int>& nums) {

      int n=nums.size(),count=0,condidate;
      for(int i=0;i<n;i++)
      {
        if(count==0)
        {
        count=1;
        condidate=nums[i];
        }
        else
        {
            if(condidate==nums[i])
        
            count++;
            else
            count--;
        }
      }
      return condidate;

    }

      
};

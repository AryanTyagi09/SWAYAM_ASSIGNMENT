class Solution {
public:
    static const int LIMIT = 1000000;
    static const int MAX_BLOCK = 200;

    bool bfs(vector<int>& start, vector<int>& finish, unordered_set<long long>& blockedSet) {
        int maxArea = MAX_BLOCK * (MAX_BLOCK - 1) / 2;
        
        queue<pair<int,int>> q;
        unordered_set<long long> visited;
        
        q.push({start[0], start[1]});
        visited.insert(1LL * start[0] * LIMIT + start[1]);

        int dirs[4][2] = {{1,0},{-1,0},{0,1},{0,-1}};

        while (!q.empty() && visited.size() <= maxArea) {
            auto [x, y] = q.front(); 
            q.pop();

            if (x == finish[0] && y == finish[1])
                return true;

            for (auto& d : dirs) {
                int nx = x + d[0];
                int ny = y + d[1];

                if (nx < 0 || ny < 0 || nx >= LIMIT || ny >= LIMIT)
                    continue;

                long long key = 1LL * nx * LIMIT + ny;
                if (blockedSet.count(key) || visited.count(key))
                    continue;

                visited.insert(key);
                q.push({nx, ny});
            }
        }
        return visited.size() > maxArea;
    }

    bool isEscapePossible(vector<vector<int>>& blocked, vector<int>& source, vector<int>& target) {
        unordered_set<long long> blockedSet;
        for (auto& b : blocked)
            blockedSet.insert(1LL * b[0] * LIMIT + b[1]);

        return bfs(source, target, blockedSet) && bfs(target, source, blockedSet);
    }
};

class MyQueue {
public:
stack<int>st1;
stack<int>st2;
 int peekl=-1;
    MyQueue() {
        
    }
    bool empty() {
        return st1.empty() && st2.empty();
       
        
    }
    
    void push(int x) {
        st1.push(x);
      
        
    }
    
    int pop() {
        if(st2.empty())
        {
            while(!st1.empty())
            {
                st2.push(st1.top());
                st1.pop();
            }
        }
        int val=st2.top();
        st2.pop();
        return val;

        
    }
    
    int peek() {
        if(empty())
        return 0;
        else if(!st2.empty())
       return st2.top();
       else
       {
         while(!st1.empty())
            {
                st2.push(st1.top());
                st1.pop();
            }
            return st2.top();
       }
        
        
    }
    
    
};


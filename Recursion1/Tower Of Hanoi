#include <iostream>
using namespace std;

long long toh(int n, int from, int to, int aux) {
    if (n == 0) return 0;
    long long moves = 0;
    moves += toh(n - 1, from, aux, to);
    moves++;
    moves += toh(n - 1, aux, to, from);
    return moves;
}

int main() {
    int n;
    cin >> n;
    cout << toh(n, 1, 3, 2);
    return 0;
}

#include <iostream>
using namespace std;

int countDividingDigits(int n) {
    int count = 0, temp = n;
    while (temp > 0) {
        int digit = temp % 10;
        temp /= 10;
        if (digit != 0 && n % digit == 0)
            count++;
    }
    return count;
}

int main() {
    int n;
    cin >> n;
    cout << countDividingDigits(n);
    return 0;
}
